# Copy this file to .env.local. These are the only variables read by the Vite browser app.
# Use the publishable key (recommended) or the legacy anon key from Supabase Project Settings → API.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# NEVER add secrets here or prefix secrets with VITE_.
# Set the following values as Supabase Edge Function secrets, not in the browser build:
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
# SUPABASE_ANON_KEY=YOUR_ANON_KEY                 # or SUPABASE_PUBLISHABLE_KEY
# APP_FRONTEND_URL=https://your-production-domain.example
# INVITE_REDIRECT_URL=https://your-production-domain.example/invite/accept
# APP_ALLOWED_ORIGINS=https://your-production-domain.example,https://www.your-production-domain.example
# GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# GEMINI_MODEL=gemini-2.5-flash
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
# GOOGLE_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/google-oauth-callback
# GOOGLE_TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS_FROM_openssl_rand_-hex_32

# For local Edge Function development only, add your actual local Supabase API URL/key
# to `supabase/functions/.env` (never commit that file), and allow the local Vite origin:
# APP_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173
